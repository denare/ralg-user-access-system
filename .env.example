# Supabase session pooler, used by a persistent local or hosted application server.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?connection_limit=5&pool_timeout=30"

# Supabase session connection, used by Prisma migrations and seeding on IPv4 networks.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
