# Supabase transaction pooler, used by Next.js runtime traffic and Vercel functions.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30&connect_timeout=5"

# Supabase session connection, used by Prisma migrations and seeding on IPv4 networks.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
