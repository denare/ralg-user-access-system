# Supabase transaction pooler, used by the running application.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"

# Supabase direct or session connection, used by Prisma migrations and seeding.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
