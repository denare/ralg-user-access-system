generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  APPLICANT
  HOD
  ICT_OFFICER
  ADMIN
}

enum RequestAction {
  CREATE_USER
  MODIFY_USER
  BLOCK_USER
  RESET_PASSWORD
}

enum OperatingEnvironment {
  PRODUCTION
  TESTING
}

enum RequestStatus {
  DRAFT
  PENDING_HOD
  PENDING_ICT
  APPROVED
  REJECTED
  COMPLETED
}

enum Decision {
  APPROVE
  REJECT
}

model User {
  id             String          @id @default(cuid())
  authUserId     String          @unique
  fullName       String
  email          String          @unique
  username       String          @unique
  phone          String?
  department     String?
  designation    String?
  region         String?
  role           UserRole
  isActive       Boolean         @default(true)
  requests       AccessRequest[] @relation("Requester")
  approvals      Approval[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([role])
  @@index([department])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemCatalog {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

model AccessRequest {
  id                  String                 @id @default(cuid())
  requestNumber       String                 @unique
  applicantId         String
  applicant           User                   @relation("Requester", fields: [applicantId], references: [id])
  region              String
  lga                 String
  facility            String
  action              RequestAction
  environment         OperatingEnvironment
  checkNumber         String
  nin                 String
  fullName            String
  designation         String
  department          String
  phone               String
  email               String
  targetCheckNumber   String?
  targetFullName      String?
  targetDepartment    String?
  targetEmail         String?
  targetPhone         String?
  targetDesignation   String?
  systems             RequestSystem[]
  requestedRole       String
  otherSystem         String?
  reason              String
  status              RequestStatus
  hodComment          String?
  ictComment          String?
  hodDesignation      String?
  ictDesignation      String?
  signedDocumentUrl   String?
  completedAt         DateTime?
  approvals           Approval[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([applicantId])
  @@index([applicantId, status])
  @@index([status])
  @@index([department])
  @@index([createdAt])
}

model RequestSystem {
  id        String        @id @default(cuid())
  requestId String
  request   AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  system    String

  @@unique([requestId, system])
}

model Approval {
  id           String        @id @default(cuid())
  requestId    String
  request      AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId   String
  approver     User          @relation(fields: [approverId], references: [id])
  approverRole UserRole
  decision     Decision
  comment      String?
  designation  String?
  signatureUrl String?
  decidedAt    DateTime      @default(now())

  @@unique([requestId, approverRole])
  @@index([requestId])
  @@index([approverId])
}
